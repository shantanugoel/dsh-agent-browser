{
  "name": "dsh-agent-browser",
  "version": "0.2.5",
  "description": "Native DSH browser tools on agent-browser: snapshot+ref automation, batched actions, live viewport panel. One-line install: dsh plugin --profile web add dsh-agent-browser",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./client/index.d.ts",
      "default": "./client/dist/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "client/index.d.ts",
    "client/dist/client.js"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "dsh-agent-browser-core": "workspace:*",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "esbuild": "^0.28.2",
    "@types/react": "^19",
    "react": "^19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shantanugoel/dsh-agent-browser.git",
    "directory": "packages/dsh-agent-browser"
  },
  "bugs": {
    "url": "https://github.com/shantanugoel/dsh-browser-control/issues"
  },
  "homepage": "https://github.com/shantanugoel/dsh-browser-control#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent-browser",
    "browser-automation",
    "plugin",
    "bundle"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
